FoamFile
{
    format  ascii;
    class   dictionary;
    object  snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    heatPipe.stl  { type triSurfaceMesh; name heatPipe_wall; }
    fuelPin1.stl  { type triSurfaceMesh; name fuelPin1_wall; }
    fuelPin2.stl  { type triSurfaceMesh; name fuelPin2_wall; }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      4000000;
    minRefinementCells  5;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;
    resolveFeatureAngle 30;
    allowFreeStandingZoneFaces true;

    features
    (
        { file "heatPipe.eMesh";  level 3; }
        { file "fuelPin1.eMesh";  level 3; }
        { file "fuelPin2.eMesh";  level 3; }
    );

    refinementSurfaces
    {
        heatPipe_wall
        {
            level (3 4);
            patchInfo { type wall; }
        }
        fuelPin1_wall
        {
            level (3 4);
            patchInfo { type wall; }
        }
        fuelPin2_wall
        {
            level (3 4);
            patchInfo { type wall; }
        }
    }

    refinementRegions
    {
        heatPipe_wall  { mode inside; levels ((4 4)); }
        fuelPin1_wall  { mode inside; levels ((4 4)); }
        fuelPin2_wall  { mode inside; levels ((4 4)); }
    }

    // point clearly inside graphite — not inside any cylinder
    // at 15 degrees, between fp2 and HP
    locationInMesh (0.022 0.006 0.80);
}

snapControls
{
    nSmoothPatch        5;
    tolerance           1.5;
    nSolveIter          50;
    nRelaxIter          8;
    nFeatureSnapIter    15;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers {}
    expansionRatio 1.0;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 0;
    featureAngle 60;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    maxNonOrtho         75;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-15;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.01;
    minDeterminant      0.001;
    minFaceWeight       0.02;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;
    relaxed
    {
        maxNonOrtho 85;
    }
}

mergeTolerance 1e-6;
