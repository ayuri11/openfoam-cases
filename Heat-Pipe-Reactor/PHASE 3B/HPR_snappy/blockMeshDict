{
    format  ascii;
    class   dictionary;
    object  blockMeshDict;
}

scale 1;

// domain: x=0→0.0275m, y=0→0.0159m, z=0→1.60m
// key fix: nz=200 so dz=8mm ≈ 2× hp_r → proper snapping in axial direction
// nx=30, ny=18 → dx=0.92mm, dy=0.88mm → good radial resolution

vertices
(
    (0      0      0   )   // 0
    (0.0275 0      0   )   // 1
    (0.0275 0.0159 0   )   // 2
    (0      0.0159 0   )   // 3
    (0      0      1.60)   // 4
    (0.0275 0      1.60)   // 5
    (0.0275 0.0159 1.60)   // 6
    (0      0.0159 1.60)   // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (30 18 200) simpleGrading (1 1 1)
);

edges ();

boundary
(
    sym_y0   { type symmetry; faces ((0 1 5 4)); }
    sym_ymax { type symmetry; faces ((3 7 6 2)); }
    sym_x0   { type symmetry; faces ((0 3 7 4)); }
    outer    { type wall;     faces ((1 2 6 5)); }
    bottom   { type wall;     faces ((0 1 2 3)); }
    top      { type wall;     faces ((4 5 6 7)); }
);
